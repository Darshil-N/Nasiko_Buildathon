# Copy to .env.local and fill in. Never commit .env.local.

# The real backend's base URL (server-side only; never exposed to the browser)
BACKEND_URL=http://localhost:8000/v1
# Must match BACKEND_API_KEY in the backend's own .env
BACKEND_API_KEY=

# CARTO Basemaps API key (free tier, https://carto.com/basemaps). This one IS meant for the
# browser (map tile requests), hence the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_CARTO_API_KEY=
