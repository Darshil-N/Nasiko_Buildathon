# SiteScout environment (free MVP). Copy to .env and fill in. Never commit .env.
# Anakin and DronaHQ variables from the architecture doc are intentionally absent (plan.md section 2).

# --- LLM (free route: Ollama primary, OpenRouter free as backup) ---
LLM_PROVIDER=ollama                  # ollama | openrouter
OLLAMA_BASE_URL=http://localhost:11434/v1
OPENROUTER_API_KEY=                  # optional backup; use a FREE-tier key only
LLM_MODEL_SMALL=qwen2.5:7b-instruct  # classification, extraction fallback
LLM_MODEL_WRITER=qwen2.5:7b-instruct # narratives and chat
LLM_MODEL_BACKUP=                    # a free OpenRouter model id (decision D-03 still open)

# --- Nasiko (installed at D:\Projects\Nasiko, dashboard and API on port 8080) ---
NASIKO_BASE_URL=http://localhost:8080
NASIKO_TOKEN=                        # set after logging in; see progress.md 0.3.8

# --- Database (PostGIS in Docker; host port 5433 because Nasiko's own Postgres uses 5432) ---
# Nothing here is created or changed without the owner's approval (rule 2, gate G-DB).
DATABASE_URL=postgresql+psycopg://sitescout:sitescout@localhost:5433/sitescout

# --- Backend ---
BACKEND_API_KEY=change-me            # shared with the Streamlit app (server side only)
ALLOWED_ORIGINS=http://localhost:8501
LOG_LEVEL=INFO

# --- Geo ---
OVERPASS_URL=https://overpass-api.de/api/interpreter
GEOCODER_URL=                        # Nominatim or Photon, decision D-08
H3_RESOLUTION=9
